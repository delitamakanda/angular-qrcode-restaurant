{
  // For more information, visit: https://angular.dev/ai/mcp
  "servers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp",
        "--isolated",
        "--device",
        "iPhone 13",
        "--caps",
        "testing",
        "--allowed-origins",
        "http://localhost:4200,http://127.0.0.1:4200,http://localhost:5173,http://127.0.0.1:5173",
        "--output-dir",
        "playwright-output",
        "--headless"
      ]
    }
  }
}
