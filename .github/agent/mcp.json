{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp",
        "--isolated",
        "--device",
        "iPhone 13",
        "--caps",
        "testing",
        "--allowed-origins",
        "http://localhost:4200;http://127.0.0.1:4200;http://localhost:3000",
        "--output-dir",
        "playwright-output",
        "--headless"
      ]
    }
  }
}
